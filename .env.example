# Database
MYSQL_PASSWORD=replace-with-a-long-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-value
DATABASE_POOL_SIZE=10

# S3-compatible object storage (Garage in production)
GARAGE_DEFAULT_BUCKET=vidu-studio-media
GARAGE_DEFAULT_ACCESS_KEY=replace-with-garage-access-key
GARAGE_DEFAULT_SECRET_KEY=replace-with-garage-secret-key

# Independent random secrets; do not reuse values
SESSION_TOKEN_PEPPER=replace-with-64-hex-characters
ABUSE_HASH_SECRET=replace-with-64-hex-characters
PROVIDER_KEY_ENCRYPTION_SECRET=replace-with-64-hex-characters
INTERNAL_HEALTH_SECRET=replace-with-64-hex-characters

# Initial administrator allowlist
ADMIN_EMAILS=admin@example.com

# Provider keys can alternatively be encrypted and managed from the admin UI
VIDU_API_KEY=
GEMINI_API_KEY=

# Optional named provider slots
VIDU_API_KEY_PRIMARY=
VIDU_API_KEY_BACKUP=
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_BACKUP=

# Optional compatibility login
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Enable only during an approved administrator recovery window
ADMIN_RECOVERY_SECRET=
