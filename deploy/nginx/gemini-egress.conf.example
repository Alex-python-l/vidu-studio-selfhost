# Install on a Gemini-supported egress host. This listener is intentionally
# loopback-only and is reached from the application through an SSH tunnel.
server {
    listen 127.0.0.1:3910;
    server_name _;

    access_log off;
    error_log /www/wwwlogs/gemini-egress.error.log warn;
    client_max_body_size 55m;
    resolver 100.100.2.136 100.100.2.138 ipv6=off valid=300s;
    resolver_timeout 5s;

    location / {
        set $gemini_upstream generativelanguage.googleapis.com;
        proxy_pass https://$gemini_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host generativelanguage.googleapis.com;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name generativelanguage.googleapis.com;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 15s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}

